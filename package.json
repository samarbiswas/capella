{
  "name": "capella",
  "displayName": "Capella",
  "description": "A deep near-black, eye-friendly dark theme where every colour has a meaning, with a Capella sidebar panel",
  "version": "1.3.0",
  "publisher": "samarbiswas",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#000000", "theme": "dark" },
  "repository": { "type": "git", "url": "https://github.com/samarbiswas/capella.git" },
  "bugs": { "url": "https://github.com/samarbiswas/capella/issues" },
  "homepage": "https://github.com/samarbiswas/capella#readme",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Themes", "Other"],
  "keywords": ["theme", "dark", "black", "oled", "eye-friendly"],
  "main": "./extension.js",
  "activationEvents": ["onView:capella.panel", "onCommand:capella.openPanel"],
  "contributes": {
    "themes": [
      {
        "label": "Capella",
        "uiTheme": "vs-dark",
        "path": "./themes/capella-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "capella", "title": "Capella", "icon": "images/sidebar-star.svg" }
      ]
    },
    "views": {
      "capella": [
        { "type": "webview", "id": "capella.panel", "name": "Settings" }
      ]
    },
    "commands": [
      { "command": "capella.openPanel", "title": "Open Settings", "category": "Capella" }
    ]
  }
}

  "semanticTokenColors": {
    "parameter": {
      "foreground": "#f09a6e",
      "italic": true
    },
    "enumMember": "#a99ce8",
    "function": "#a3d27a",
    "method": "#a3d27a",
    "class": "#7ccfdb",
    "type": "#7ccfdb",
    "interface": "#7ccfdb",
    "property": "#e6e6e3",
    "selfParameter": {
      "foreground": "#939293",
      "italic": true
    },
    "property.readonly.defaultLibrary": "#a99ce8",
    "clsParameter": {
      "foreground": "#939293",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#e6e6e3",
        "background": "#000000"
      }
    },
    {
      "name": "NOTES (grey, italic): comments, for humans only",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#807e81",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CONTROL (pink): words that change the flow - if, return, raise, import, and/or/not",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "keyword.operator.new",
        "entity.name.tag",
        "punctuation.definition.tag",
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#f0708f"
      }
    },
    {
      "name": "TEXT DATA (yellow): strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#d4b866"
      }
    },
    {
      "name": "FIXED VALUES (purple): numbers, true/false/null, constants, escapes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "support.constant",
        "variable.other.enummember",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a99ce8"
      }
    },
    {
      "name": "ACTIONS (green): functions and methods - things that do work",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "entity.name.function.decorator",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a3d27a"
      }
    },
    {
      "name": "SHAPES (cyan): types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7ccfdb"
      }
    },
    {
      "name": "STORAGE WORDS (pink, italic): let, const, var, interface, type, enum",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#f0708f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PRIMITIVE TYPES (cyan): int, char and similar",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.rune.go",
        "storage.type.error.go",
        "storage.type.uintptr.go"
      ],
      "settings": {
        "foreground": "#7ccfdb",
        "fontStyle": ""
      }
    },
    {
      "name": "DEFINE WORDS (pink, italic): def, class, function",
      "scope": [
        "storage.type.function",
        "storage.type.class",
        "storage.type.function.arrow",
        "keyword.declaration.function",
        "keyword.declaration.class"
      ],
      "settings": {
        "foreground": "#f0708f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "INPUTS (orange, italic): function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#f09a6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "OWN OBJECT (dim grey, italic): self / this",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#939293",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PLAIN NAMES (white): variables and properties",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name.json",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e6e6e3"
      }
    },
    {
      "name": "GLUE (dim): brackets, commas, dots, and operators like = + < *",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational"
      ],
      "settings": {
        "foreground": "#939293"
      }
    },
    {
      "name": "DANGER (strong red, underlined): invalid code",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5f6d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "LINKS (cyan, underlined)",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7ccfdb",
        "fontStyle": "underline"
      }
    },
    {
      "name": "DELETED LINES (pink)",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f0708f"
      }
    },
    {
      "name": "MARKDOWN HEADINGS (soft white, bold)",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f2f2ef",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKDOWN BOLD",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKDOWN ITALIC",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "ATTRIBUTE AND KEY NAMES (off-white): HTML attributes, CSS properties, YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "entity.other.attribute-name",
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#e6e6e3"
      }
    }
  ]
}

  "semanticTokenColors": {
    "parameter": {
      "foreground": "#f09a6e",
      "italic": true
    },
    "variable.readonly": "#a99ce8",
    "enumMember": "#a99ce8",
    "function": "#a3d27a",
    "method": "#a3d27a",
    "class": "#7ccfdb",
    "type": "#7ccfdb",
    "interface": "#7ccfdb",
    "property": "#e6e6e3",
    "selfParameter": {
      "foreground": "#939293",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#e6e6e3",
        "background": "#000000"
      }
    },
    {
      "name": "NOTES (grey, italic): comments, for humans only",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#807e81",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CONTROL (pink-red): keywords that change the flow - if, return, import, operators",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.modifier",
        "keyword.operator.new",
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f0708f"
      }
    },
    {
      "name": "TEXT DATA (yellow): strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e8cc72"
      }
    },
    {
      "name": "FIXED VALUES (purple): numbers, true/false/null, constants, escapes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a99ce8"
      }
    },
    {
      "name": "ACTIONS (green): functions and methods - things that do work",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.decorator",
        "entity.name.function.decorator",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a3d27a"
      }
    },
    {
      "name": "SHAPES (cyan): types, classes, def/class/function words, attributes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.other.attribute-name",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#7ccfdb"
      }
    },
    {
      "name": "DEFINE WORDS (cyan, italic): def, class, function",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#7ccfdb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "INPUTS (orange, italic): function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "markup.changed",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f09a6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "OWN OBJECT (dim grey, italic): self / this",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#939293",
        "fontStyle": "italic"
      }
    },
    {
      "name": "PLAIN NAMES (white): variables and properties",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#e6e6e3"
      }
    },
    {
      "name": "GLUE (dim): brackets, commas, dots",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#939293"
      }
    },
    {
      "name": "DANGER (strong red, underlined): invalid code",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5f6d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "LINKS (cyan, underlined)",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7ccfdb",
        "fontStyle": "underline"
      }
    },
    {
      "name": "DELETED LINES (pink)",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f0708f"
      }
    }
  ]
}
